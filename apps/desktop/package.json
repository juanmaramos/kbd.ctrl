{
  "name": "kbd-ctrl",
  "private": true,
  "version": "0.1.0",
  "description": "macOS companion for a programmable three-key macropad",
  "license": "MIT",
  "repository": "github:juanmaramos/kbd.ctrl",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "format": "prettier --write \"src/**/*.{ts,tsx}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx}\" \"package.json\" \"index.html\"",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview",
    "tauri": "tauri",
    "app:dev:signed": "../../scripts/run-signed-dev.sh"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@fontsource-variable/figtree": "^5.3.0",
    "@fontsource-variable/noto-sans": "^5.3.0",
    "@tabler/icons-react": "^3.46.0",
    "@tailwindcss/vite": "^4",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-opener": "^2.5.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "shadcn": "^4.16.0",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@eslint/js": "^10",
    "@tauri-apps/cli": "^2.11.4",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6",
    "eslint": "^10",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17",
    "prettier": "^3.8.3",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "typescript": "~6",
    "typescript-eslint": "^8",
    "vite": "^8"
  }
}
